# Copy to .env  (never commit .env)

# ---- Server ----
PORT=4000
DB_FILE=./data/exit.sqlite

# ---- Identity ----
# dev   = LOCAL TESTING ONLY: no login, user switcher in the header. Refused when NODE_ENV=production.
# entra = production: Microsoft Entra ID tokens (not implemented yet — see README → Authentication).
AUTH_MODE=dev


# ---- Separately hosted frontend (optional, e.g. Vercel) ----
# Comma-separated origins allowed to call this API.
ALLOWED_ORIGINS=

# ---- Inbound integration events (optional) ----
# Shared key OneUI / MiHCM must send in the X-Integration-Key header. Leave empty to disable.
INTEGRATION_SHARED_SECRET=
